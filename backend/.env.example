# Application Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Database Configuration (Supabase PostgreSQL / Local PostgreSQL)
# For Supabase connection pooler (Session mode, port 5432):
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/educaro_companion

# Optional discrete parameters:
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=educaro_companion

# Database Settings
DB_SSL=false
DB_SYNCHRONIZE=false
DB_LOGGING=true

# Supabase Storage Configuration
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=educaro-documents
MAX_FILE_SIZE_MB=10

# Document Extraction Service (Member 4)
DOCUMENT_EXTRACTION_SERVICE_URL=http://localhost:3001
DOCUMENT_EXTRACTION_TIMEOUT_MS=30000

# Gemini AI Configuration (Phase 1)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs Voice Configuration
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_AUTHORIZED_USER_IDS=
TELEGRAM_POLLING_ENABLED=true
TELEGRAM_DEFAULT_APPLICANT_ID=demo-applicant-123
