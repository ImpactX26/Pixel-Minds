# Application Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database Configuration (Supabase PostgreSQL / Local PostgreSQL)
# For Supabase connection pooler (Session mode, port 5432):
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/educaro_companion

# Optional discrete parameters:
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=educaro_companion

# Database Settings
DB_SSL=false
DB_SYNCHRONIZE=false
DB_LOGGING=true

# Supabase Storage Configuration
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=educaro-documents
MAX_FILE_SIZE_MB=10
