# ==============================================================================
# PixelMind AI - Member 4 Document Intelligence & Extraction Service (.env.example)
# ==============================================================================

# Server Configuration
PORT=3001
NODE_ENV=development

# AI Provider Configuration ('gemini', 'openai', or 'mock')
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OCR Provider Configuration ('tesseract', 'pdf-native', 'gemini-vision', 'mock')
OCR_PROVIDER=tesseract

# Document Download & Storage access (Optional fallback if private Supabase storage URLs are passed)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
