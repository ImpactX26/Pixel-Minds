# Telegram Bot Token (obtained from @BotFather on Telegram)
# Format looks like: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Local Server Port (default: 3000)
PORT=3000

# Public Tunnel URL (e.g. from ngrok or Cloudflare Tunnel)
# Used when setting the webhook: https://xxxx.ngrok-free.app
WEBHOOK_DOMAIN=https://your-tunnel-url.ngrok-free.app
